<?xml version="1.0" encoding="UTF-8"?>
<collection xmlns="http://exist-db.org/collection-config/1.0">
    <index xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <lucene vector-store="db">
            <analyzer class="org.apache.lucene.analysis.standard.StandardAnalyzer"/>
            <!-- Analyzer chains (eXist 7 lucene analyzer chains) for hsg-jinks's search
                 options. plain is the default field's: possessives dropped, words with
                 inner punctuation (F-16, S/S) indexed whole, in parts and joined,
                 lower-cased and folded. Each option leaves one step out: cased keeps
                 case; punct and literal keep punctuation inside words (literal keeps
                 case too); stemmed is plain plus English (Porter) stemming. -->
            <analyzer id="plain">
                <index>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" catenateWords="1" catenateNumbers="1" catenateAll="1"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" generateWordParts="0" generateNumberParts="0" catenateAll="1"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="cased">
                <index>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" catenateWords="1" catenateNumbers="1" catenateAll="1"/>
                    <filter name="flattenGraph"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" generateWordParts="0" generateNumberParts="0" catenateAll="1"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="punct">
                <tokenizer name="whitespace"/>
                <filter name="patternReplace" pattern="^[\p{P}\p{S}]+|[\p{P}\p{S}]+$" replacement=""/>
                <filter name="length" min="1" max="255"/>
                <filter name="lowercase"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="literal">
                <tokenizer name="whitespace"/>
                <filter name="patternReplace" pattern="^[\p{P}\p{S}]+|[\p{P}\p{S}]+$" replacement=""/>
                <filter name="length" min="1" max="255"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="stemmed">
                <index>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" catenateWords="1" catenateNumbers="1" catenateAll="1"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </index>
                <query>
                    <tokenizer name="whitespace"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" generateWordParts="0" generateNumberParts="0" catenateAll="1"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </query>
            </analyzer>
            <text qname="visit">
                <!-- start required facets and fields -->
                <facet dimension="hsg-category" expression="'department'"/>
                <facet dimension="hsg-publication" expression="'visits'"/>
                <field analyzer="plain" expression="visitor, description, from" name="hsg-fulltext"/>
                <field analyzer="stemmed" expression="visitor, description, from" name="hsg-fulltext-stemmed"/>
                <field analyzer="cased" expression="visitor, description, from" name="hsg-fulltext-cased"/>
                <field analyzer="punct" expression="visitor, description, from" name="hsg-fulltext-punct"/>
                <field analyzer="literal" expression="visitor, description, from" name="hsg-fulltext-literal"/>
                <vector-field name="hsg-embedding" expression="visitor, description, from"
                    dimension="384" similarity="cosine"
                    embedding="local" model="all-MiniLM-L6-v2"/>
                <field expression="'/departmenthistory/visits/' || year-from-date(./start-date)"
                    name="hsg-url"/>
                <!-- end required facets and fields -->
            </text>
        </lucene>
        <range>
            <create qname="id" type="xs:string"/>
            <create qname="visitor" type="xs:string"/>
            <create qname="from" type="xs:string"/>
            <create qname="@id" type="xs:string"/>
            <create qname="start-date" type="xs:date"/>
            <create qname="end-date" type="xs:date"/>
        </range>
    </index>
</collection>
